<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <!-- ── Status Bar Scrim (Emerald Green) ─────────────────────────────── -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/leaf_green"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Top Header Bar (Emerald Green) ─────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:background="@color/leaf_green"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/statusBarScrim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disease Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Field Diagnostic &amp; Care Report"
                android:textSize="12sp"
                android:textColor="#D4EEDF" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Scrollable Body ────────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="100dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ── CARD 1: Executive Diagnostic Summary ────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/diseaseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_disease_name_chip"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#B3261E"
                        tools:text="Multiple Pathogens Detected (3)" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/confidenceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary"
                        tools:text="Primary Detection:\n• Black Sigatoka (85.0%)\n\nCo-Occurring Findings:\n• Cordana Leaf Spot (49.5%)\n• Pestalotiopsis Leaf Blight (44.2%)" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 2: Visual Inspection (Scanned Specimen) ────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/background_main">

                        <ImageView
                            android:id="@+id/diseaseImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Scanned banana leaf specimen" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center_horizontal"
                        android:text="Captured Field Specimen"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 3: Identified Symptoms ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/descriptionHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/identified_symptoms_header"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.01"
                            android:textColor="@color/leaf_green_dark" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_symptom_leaf"
                            android:contentDescription="Symptoms"
                            app:tint="@color/leaf_green" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 4: Treatment & Sanitation ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/treatmentHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/treatment_recommendation_header"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.01"
                            android:textColor="@color/leaf_green_dark" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_treatment_drop"
                            android:contentDescription="Treatment"
                            app:tint="@color/leaf_green" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/treatmentText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 5: Prevention & Canopy Management ──────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/preventionHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/prevention_management_header"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.01"
                            android:textColor="@color/leaf_green_dark" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_prevention_shield"
                            android:contentDescription="Prevention"
                            app:tint="@color/leaf_green" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/preventionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 6: Agricultural Extension & Field Monitoring (NEW) ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeWidth="0dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/monitoringHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Extension &amp; Monitoring Guidance"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.01"
                            android:textColor="@color/leaf_green_dark" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_lgu_connect"
                            android:contentDescription="Extension Guidance"
                            app:tint="@color/leaf_green" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/monitoringText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary"
                        tools:text="• Inspect young emerging leaves every 7 to 10 days.\n• Check neighboring mats for early speckling." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CARD 7: Field Advisory / Screening Note ─────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardMaxElevation="6dp"
                android:outlineAmbientShadowColor="@color/card_shadow_ambient"
                android:outlineSpotShadowColor="@color/card_shadow_spot"
                app:cardBackgroundColor="#FAFDFB"
                app:strokeColor="#E0ECE3"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/detailsWarningNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/details_view_warning" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- ── Floating Glassmorphism Bottom Navigation Bar ───────────────────── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_nav_glassmorphic_light"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:backgroundTint="@null"
        app:elevation="20dp"
        android:outlineAmbientShadowColor="@color/card_shadow_ambient"
        android:outlineSpotShadowColor="@color/card_shadow_spot"
        app:itemIconSize="22dp"
        app:itemPaddingTop="9dp"
        app:itemPaddingBottom="11dp"
        app:itemTextAppearanceActive="@style/BottomNavText.Active"
        app:itemTextAppearanceInactive="@style/BottomNavText.Inactive"
        app:itemRippleColor="@color/leaf_green_ripple"
        app:itemIconTint="@color/nav_icon_selector"
        app:itemTextColor="@color/nav_icon_selector"
        app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicatorLight"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
