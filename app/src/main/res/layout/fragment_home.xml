<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/black">

    <!-- Camera blur target — live preview -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/cameraBlurTarget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Camera preview"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Blur overlay — everything outside the scan frame is slightly blurred -->
    <com.thesis.bananaleaf.MaskedBlurView
        android:id="@+id/blurOutsideFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="3dp"
        app:blurOverlayColor="#20000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Freeze frame shown after capture -->
    <ImageView
        android:id="@+id/capturedFreezeFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:contentDescription="Captured leaf photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- TOP BAR — frosted glassmorphic pill floating over camera           -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_top_bar_glass"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button_glass"
            android:clickable="true"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="@string/flash_off"
            android:stateListAnimator="@null"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button_glass"
            android:contentDescription="App Guide"
            android:padding="9dp"
            android:src="@drawable/ic_settings_simple"
            android:tint="#FFFFFF"
            android:stateListAnimator="@null"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- STATUS PILL — frosted glass card with status & confidence         -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- STATUS CAPSULE — Minimalist floating glass pill                    -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_status_capsule_idle"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_status_dot_searching" />

        <TextView
            android:id="@+id/detectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Looking for banana leaf…"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/detectionConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:background="@drawable/bg_confidence_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <!-- Kept for ViewBinding compat, hidden -->
        <FrameLayout
            android:id="@+id/statusConfidenceBarTrack"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <View
                android:id="@+id/statusConfidenceBarFill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- SCAN FRAME — Fixed AR reticle viewfinder guide                    -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintDimensionRatio="1:1">

        <com.thesis.bananaleaf.ScanCornerFrameView
            android:id="@+id/scanFrameCorners"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- HINT PILL — frosted glass instruction text above shutter          -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/detectionHealth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Center a real banana leaf inside the frame"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:background="@drawable/bg_hint_pill_glass"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/captureButtonRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Processing spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="gone"
        android:indeterminateTint="@color/leaf_green"
        app:layout_constraintBottom_toTopOf="@id/captureButtonRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- PRO CAMERA SHUTTER BUTTON — concentric ring + haptic bounce        -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/captureButtonRing"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/bg_capture_ring_idle"
        android:elevation="28dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/captureButton"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text=""
            android:contentDescription="Scan banana leaf"
            app:backgroundTint="@color/leaf_green"
            app:cornerRadius="33dp"
            app:icon="@drawable/ic_leaf_shutter"
            app:iconTint="@null"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:elevation="8dp"
            app:rippleColor="@color/leaf_green_ripple" />

    </FrameLayout>

    <!-- Inference stats (telemetry HUD bar, placed cleanly below status pill) -->
    <TextView
        android:id="@+id/inferenceStatsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_inference_stats"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Inference: -- ms | FPS: -- | RAM: -- MB"
        android:textColor="#E0FFFFFF"
        android:textSize="10.5sp"
        android:visibility="visible"
        android:elevation="14dp"
        app:layout_constraintTop_toBottomOf="@id/statusPill"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="SmallSp" />

</androidx.constraintlayout.widget.ConstraintLayout>
