<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/black">

    <!--
        Fragment container: hosts HomeFragment (camera), GardenFragment,
        DiscoverFragment, LguConnectFragment.
        HomeFragment is always ADDED, never replaced, so the camera lifecycle
        is preserved when switching tabs.
    -->
    <!--
        Fragment container: hosts HomeFragment (camera), GardenFragment,
        DiscoverFragment, LguConnectFragment.
        Extends to the bottom of parent so the camera preview seamlessly
        fills edge-to-edge behind the floating glass bottom navigation bar.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Status Bar Scrim:
        Provides a rich emerald green background across the status bar area
        on tabs like My Garden, Discover, and LGU Connect, ensuring the phone's
        notifications, clock, and battery are clearly visible.
        Hidden on Home tab for full-bleed camera preview.
    -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/leaf_green"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Floating Glassmorphism Bottom Navigation Bar:
        Suspended with 16dp margins and 32dp corner radius.
        Uses frosted glass background and dynamic adaptive theme.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_nav_glassmorphic_dark"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:backgroundTint="@null"
        app:elevation="20dp"
        android:outlineAmbientShadowColor="@color/card_shadow_ambient"
        android:outlineSpotShadowColor="@color/card_shadow_spot"
        app:itemIconSize="22dp"
        app:itemPaddingTop="9dp"
        app:itemPaddingBottom="11dp"
        app:itemTextAppearanceActive="@style/BottomNavText.Active"
        app:itemTextAppearanceInactive="@style/BottomNavText.Inactive"
        app:itemRippleColor="@color/leaf_green_ripple"
        app:itemIconTint="@color/nav_icon_selector_dark"
        app:itemTextColor="@color/nav_icon_selector_dark"
        app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicatorDark"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
