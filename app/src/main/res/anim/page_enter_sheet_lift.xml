<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Subtle Sheet Lift: 100% opaque, 0 fade.
        Translates up by 4% (~30dp) with fast_out_slow_in deceleration.
        Completely eliminates grayish color blending and background gaps.
    -->
    <translate
        android:fromYDelta="4%"
        android:toYDelta="0%"
        android:duration="220"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
