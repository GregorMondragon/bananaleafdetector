<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Subtle Spring Zoom (Scale Settle): 100% opaque, 0 fade.
        Scales from 96% to 100% centered at (50%, 50%) over 200ms.
        Eliminates grayish blending, screen tearing, and background flash.
    -->
    <scale
        android:fromXScale="0.96"
        android:toXScale="1.0"
        android:fromYScale="0.96"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="200"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
