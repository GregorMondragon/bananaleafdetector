<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BananaLeafDetector" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/leaf_green</item>
        <item name="colorPrimaryDark">@color/leaf_green_dark</item>
        <item name="colorAccent">@color/leaf_green</item>
        <item name="colorSecondary">@color/leaf_green</item>
        <item name="colorSecondaryContainer">@color/nav_indicator</item>
        <item name="colorSurface">@color/card_white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!--
            App font: sans-serif.
            Fully offline — no bundled font assets required.
            Applied as the global default; individual views can override it.
        -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <style name="BottomNavActiveIndicatorDark" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator_dark</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <style name="BottomNavActiveIndicatorLight" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator_light</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
        <item name="marginHorizontal">0dp</item>
    </style>

    <!-- Rounded rectangle shape for nav active indicator -->
    <style name="NavIndicatorShape" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Bottom Navigation Typography: Clean, refined 10.5sp with zero font padding for tight, balanced alignment -->
    <style name="BottomNavText.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="BottomNavText.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
