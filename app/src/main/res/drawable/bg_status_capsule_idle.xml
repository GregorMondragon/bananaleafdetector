<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted minimalist glass capsule for searching state -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#B8141F18"
        android:endColor="#990C1611"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
