<?xml version="1.0" encoding="utf-8"?>
<!-- Premium minimalist glassmorphic active indicator for dark glass bottom nav -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:startColor="#5548A55A"
        android:endColor="#3830843E"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
