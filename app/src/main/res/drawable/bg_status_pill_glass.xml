<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card for scanner status pill -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:startColor="#B8121C16"
        android:endColor="#9A0A120E"
        android:type="linear" />
    <stroke
        android:width="1.2dp"
        android:color="#33FFFFFF" />
</shape>
